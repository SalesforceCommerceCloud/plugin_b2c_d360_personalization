<iscomment>
    SFRA-tile variant of the PDP personalization slot: assign this template (instead of
    pdp.isml) in the content slot configuration to render recommendation tiles via the
    storefront's native, already-cached Tile-Show product tile instead of client-side SCAPI
    hydration. See the README's Render mode section for the render-mode comparison.
</iscomment>
<isset name="contextKey" value="${'pdp-recommendations'}" scope="pdict" />
<isset name="renderMode" value="${'sfra'}" scope="pdict" />
<isinclude template="personalization/productRecommendations" />
