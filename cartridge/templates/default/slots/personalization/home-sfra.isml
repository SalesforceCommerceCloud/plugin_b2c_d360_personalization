<iscomment>
    SFRA-tile variant of the home personalization slot: assign this template (instead of
    home.isml) in the content slot configuration to render recommendation tiles via the
    storefront's native, already-cached Tile-Show product tile instead of client-side SCAPI
    hydration. See docs/architecture-and-design/PersonalizationSCAPI-Design.md for the render-mode comparison.
</iscomment>
<isset name="contextKey" value="${'home-hero'}" scope="pdict" />
<isset name="renderMode" value="${'sfra'}" scope="pdict" />
<isinclude template="personalization/productRecommendations" />
